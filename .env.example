# 1. API & App URL
NEXT_PUBLIC_API_URL=https://api.saracota.com.br
NEXT_PUBLIC_APP_URL=https://saracota.com.br

# 2. Supabase / Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# 3. WhatsApp Business API / Webhook Credentials
WHATSAPP_API_TOKEN=seu-token-whatsapp-business-api
WHATSAPP_WEBHOOK_VERIFY_TOKEN=seu-verify-token-aqui
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1234567890

# 4. Cofre de Credenciais (AES-256 Secret)
ENCRYPTION_KEY=sua-chave-mestre-32-bytes-aes256-aqui
